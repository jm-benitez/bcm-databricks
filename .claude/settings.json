{
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(databricks bundle validate --target dev*)",
      "Bash(databricks genie list-spaces*)",
      "Bash(databricks genie get-space*)",
      "Bash(databricks genie start-conversation*)",
      "Bash(databricks genie create-message*)",
      "Bash(databricks genie get-message*)",
      "Bash(databricks genie get-message-attachment-query-result*)",
      "Bash(databricks tables get nectar.bronze.*)",
      "Bash(databricks tables get nectar.silver.*)",
      "Bash(databricks tables get nectar.gold.*)",
      "Bash(databricks tables get nectar.ops.*)",
      "Bash(databricks tables get nectar.dev_tqaddoumi_tqaddoumi_bronze.*)",
      "Bash(pytest tests/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.databrickscfg)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/*credentials*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/*credentials*)",
      "Bash(databricks bundle deploy*prod*)",
      "Bash(databricks bundle deploy*production*)",
      "Bash(databricks bundle destroy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(databricks experimental aitools tools query*)",
      "Bash(databricks experimental genie ask*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(*redis-cli*)",
      "Bash(*eventbridge*)",
      "Bash(*aws events*)",
      "Bash(*nectar_prod*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_tools*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_silver*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_gold*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_ref*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_ops*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_config*)",
      "Bash(databricks * dev_tqaddoumi_tqaddoumi_alerting*)",
      "Bash(databricks * dev_mkiwan_sandbox*)"
    ],
    "ask": [
      "Bash(databricks bundle deploy*)",
      "Bash(databricks bundle run*)",
      "Bash(databricks genie create-space*)",
      "Bash(databricks genie update-space*)",
      "Bash(databricks secrets*)",
      "Bash(git push*)",
      "mcp__atlassian"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pretool-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__atlassian__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/jira-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/posttool-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-secret-scan.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "databricks@claude-plugins-official": true
  }
}
